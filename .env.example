# === 数据库（Prisma / SQLite）===
# 必填。指向本地 SQLite 文件；该文件含明文 API Key 与站点 Cookie，已在 .gitignore 中排除，切勿提交。
# 建议放在仓库之外，例如 D:/data/video-study-agent/dev.db
DATABASE_URL="file:./prisma/dev.db"

# === Runtime 进程 ===
# Runtime 监听端口（默认 3100）
RUNTIME_PORT=3100
# Runtime 监听地址。默认仅本机回环：Runtime 无鉴权，且 Agent 持有 run_command /
# 文件读写等工具，暴露到局域网等于把本机交给对方。确认已自行加鉴权后再改。
RUNTIME_HOST=127.0.0.1
# 允许跨域访问 Runtime 的 Web 控制台地址（CORS 白名单，默认 http://localhost:3000）
RUNTIME_WEB_ORIGIN=http://localhost:3000
# Runtime 任务/会话数据库（与上面的 Prisma 库相互独立）
AGENT_DB_PATH=data/agent.db
# Agent 文件工具的沙箱根目录（默认为当前工作目录）
RUNTIME_WORKSPACE=

# === Web 前端 ===
# 浏览器侧访问 Runtime 的地址（必须能被浏览器直接访问，故用 NEXT_PUBLIC_ 前缀）
NEXT_PUBLIC_RUNTIME_URL=http://localhost:3100

# === 外部工具（可选）===
# ffmpeg 可执行文件路径。默认使用 PATH 中的 ffmpeg；仅在 ffmpeg 不在 PATH 或
# 需要指定特定版本时设置。
# FFMPEG_PATH=D:/ffmpeg/bin/ffmpeg.exe
