// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Video {
  id        String   @id @default(cuid())
  title     String?
  source    String   // 'bilibili' | 'youtube' | 'local'
  url       String?
  localPath String?
  duration  Int?
  thumbnail String?
  status    String   @default("pending") // 'pending' | 'downloading' | 'transcribing' | 'done' | 'error'
  error     String?
  transcripts String? // JSON string of transcription segments
  summary     String? // JSON string of generated summary
  mindmap     String? // Mermaid diagram code for mind map
  createdAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
