// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Video {
  id        String   @id @default(cuid())
  title     String?
  source    String   // 'bilibili' | 'youtube' | 'local'
  url       String?
  localPath String?
  duration  Int?
  thumbnail String?
  status    String   @default("pending") // 'pending' | 'downloading' | 'transcribing' | 'done' | 'error'
  error     String?
  transcripts String? // JSON string of transcription segments
  summary     String? // JSON string of generated summary
  mindmap     String? // Mermaid diagram code for mind map
  createdAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model LlmProvider {
  id        String   @id @default(cuid())
  name      String   // 显示名称，如 "MiniMax", "DeepSeek", "OpenRouter"
  apiKey    String   // API Key
  baseUrl   String   // API 端点
  models    String   // 模型列表，逗号分隔，如 "MiniMax-M2.7,deepseek-v4-flash"
  isDefault Boolean  @default(false) // 是否为默认供应商
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
