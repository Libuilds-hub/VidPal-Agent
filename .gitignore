# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# 敏感/临时文件
/cookies.txt
/scratch/
/test-screenshots/

# 本地数据库（含 API Key、站点 Cookie 等明文凭证，绝不入库）
/prisma/*.db
/prisma/*.db-shm
/prisma/*.db-wal
/prisma/*.db-journal
/prisma/migrations/**/*.db

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

/.agents/

/.playwright-cli/

# Agent 工具与会话状态（本地，不入库）
/.claude/
/.superpowers/
/.mimosa/
/snapshot.txt

# AI 助手配置与内部文档（本地，不入库）
/AGENTS.md
/CLAUDE.md
/docs/

# Runtime 本地数据（SQLite 等，不入库）
/data/

# SQLite WAL 伴生文件
*.db-shm
*.db-wal
*.db-journal
